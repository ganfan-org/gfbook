{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:build",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/debug-build.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "vite:dev",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/vite-dev.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "dev:clean-app",
        "dev:build"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[vite\\] starting",
          "endsPattern": "\\[vite\\] ready"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev:clean-app",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/debug-clean-app.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "dev:stop",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/debug-stop.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
