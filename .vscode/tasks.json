{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tauri:build-dev",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--manifest-path",
        "${workspaceFolder}/src-tauri/Cargo.toml",
        "--no-default-features"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TAURI_CONFIG": "{\"productName\":\"Ganfan Book Dev\",\"identifier\":\"org.ganfan.app.gfbook.dev\"}"
        }
      },
      "problemMatcher": [
        "$rustc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "vite:dev",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "dependsOn": [
        "tauri:build-dev"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "http://localhost:1420"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
