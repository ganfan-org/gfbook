{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Dev (Rust, dev books)",
      "program": "${workspaceFolder}/target/debug/GanfanBook",
      "cwd": "${workspaceFolder}",
      "env": {
        "TAURI_CONFIG": "{\"productName\":\"Ganfan Book Dev\",\"identifier\":\"org.ganfan.app.gfbook.dev\"}"
      },
      "preLaunchTask": "vite:dev",
      "preRunCommands": [
        "platform shell bash ${workspaceFolder}/scripts/debug-build.sh"
      ],
      "postDebugTask": "dev:clean-app",
      "sourceLanguages": [
        "rust"
      ]
    }
  ]
}
