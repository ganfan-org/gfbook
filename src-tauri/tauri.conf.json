{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ganfan Book",
  "mainBinaryName": "GanfanBook",
  "version": "0.2.1",
  "identifier": "org.ganfan.app.gfbook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ganfan Book",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' https: ipc: http://ipc.localhost; media-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["$HOME/**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "Developer ID Application: Bangshun Huang (3D6FY977ZR)"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDcyREU3NTg1QkQ5QkMKUldTODJWdFk1eTBIMjUrVnlyYUNiYTdrcXYxdTJSWFhnTTlERFU4N2VCM05CdXVKUDhRbWpYVTMK",
      "endpoints": [
        "https://github.com/ganfan-org/gfbook/releases/latest/download/latest.json"
      ]
    }
  }
}
